  "product_names": {
    "_about": "The Sales sheet's product names, the way the team types them (Frank, 2026-09-25: 'we only have 2 auto products. Farmers and BW'): the first rule whose carrier (the short name in `carriers`; none = any) and `match` (a case-insensitive regex searched in AgencyZoom's policy type name; none = always) fit names the row -- {carrier} and {raw} are filled in -- else `default`. sales_log_auto.product_name and the Worker's productName walk this same list.",
    "rules": [
      {
        "carrier": "BW",
        "match": "auto",
        "name": "BW-Auto"
      },
      {
        "carrier": "BW",
        "name": "BW-{raw}"
      },
      {
        "match": "auto",
        "name": "{carrier}-Auto"
      },
      {
        "carrier": "Foremost",
        "match": "mobile|manufactured",
        "name": "Foremost-MH"
      },
      {
        "carrier": "Foremost",
        "match": "landlord|dp\\d|dwelling",
        "name": "Foremost-Landlord"
      },
      {
        "carrier": "Foremost",
        "match": "atv|motorcycle|trailer|boat|watercraft|motor home|\\brv\\b|golf cart|toy",
        "name": "Foremost-Toys"
      },
      {
        "carrier": "Foremost",
        "match": "vacant",
        "name": "Foremost-Vacant"
      },
      {
        "carrier": "Foremost",
        "match": "home|ho-?\\d",
        "name": "Foremost-Home"
      },
      {
        "carrier": "Farmers",
        "match": "homeowner|^home$|ho-?\\d",
        "name": "Farmers-Home"
      },
      {
        "carrier": "Farmers",
        "match": "term|life",
        "name": "Farmers-Life"
      }
    ],
    "default": "{carrier}-{raw}"
  },
